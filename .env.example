# Copier en .env. Définir une clé longue et aléatoire en production.
APP_ENV=development
# SECRET_KEY=
# DATABASE_URL=postgresql://user:password@host:5432/caserne
# Dossier ABSOLU sur un disque persistant en production.
# UPLOAD_FOLDER=/var/data/caserne/uploads
# ADMIN_PASSWORD=choisir-un-mot-de-passe-provisoire-de-10-caracteres-minimum
# Obligatoire pour envoyer les liens de récupération : URL HTTPS du portail.
# PUBLIC_URL=https://mon-portail.example
# SMTP_HOST=smtp.example
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=portail@example.fr
